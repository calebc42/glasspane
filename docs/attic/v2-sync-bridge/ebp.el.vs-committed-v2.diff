+(defun ebp-client-diagnostics-show (client document editor-id diagnostics &optional seq-override)
+  "SPEC 19: push structured Flymake diagnostics for an editor session."
+  (when-let* ((ed (gethash (cons document editor-id) (ebp-client-editors client))))
+    (ebp-client-notify
+     client 'diagnostics.show
+     (list :document document :editor_id editor-id
+           :session (plist-get ed :session)
+           :seq (or seq-override (plist-get ed :seq))
+           :diagnostics (if (vectorp diagnostics) diagnostics (vconcat diagnostics))))))
+
+(defun ebp-client-fontify-show (client document editor-id runs &optional seq-override)
+  "SPEC 19: push font-lock style spans for an editor session.
+RUNS is an array or list of spans; must be sorted and non-overlapping."
+  (when-let* ((ed (gethash (cons document editor-id) (ebp-client-editors client))))
+    (ebp-client-notify
+     client 'fontify.show
+     (list :document document :editor_id editor-id
+           :session (plist-get ed :session)
+           :seq (or seq-override (plist-get ed :seq))
+           :runs (if (vectorp runs) runs (vconcat runs))))))
+
+(defun ebp-client-eldoc-show (client document editor-id text &optional seq-override)
+  "SPEC 19: push ElDoc documentation string above the editor keyboard."
+  (when-let* ((ed (gethash (cons document editor-id) (ebp-client-editors client))))
+    (ebp-client-notify
+     client 'eldoc.show
+     (list :document document :editor_id editor-id
+           :session (plist-get ed :session)
+           :seq (or seq-override (plist-get ed :seq))
+           :text (or text "")))))
+
