<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Loopback sockets still require the INTERNET permission. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- SPEC 18.5/18.6: present notification surfaces and reminders. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- SPEC 18.6: reminders fire at an exact wall-clock time. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- SPEC 20.3: the `vibrate` capability. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- SPEC 15/18.6/21.1: the Companion's durable state is an outbox and a
         cache, never a backup source. Restoring it onto another device would
         replay events this device already delivered, breaking the at-most-once
         guarantee. allowBackup=false kills cloud backup; on Android 12+ it
         does NOT stop device-to-device transfer, so the rules file below
         excludes that channel too. -->
    <application
        android:name=".EbpApplication"
        android:label="EBP Companion"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SPEC 18.6: an armed reminder fires here and posts its notification. -->
        <receiver android:name=".ReminderAlarmReceiver" android:exported="false" />
        <!-- SPEC 18.6: a reminder tap routes into the Section 14 pipeline. -->
        <receiver android:name=".ReminderTapReceiver" android:exported="false" />
        <!-- SPEC 18.5: a notification action tap routes into the Section 14 pipeline. -->
        <receiver android:name=".NotificationActionReceiver" android:exported="false" />

        <!-- SPEC 21.5: an armed time.* trigger fires here (our PendingIntent only). -->
        <receiver android:name=".TimeAlarmReceiver" android:exported="false" />
        <!-- SPEC 21.5: re-arm reminders/time triggers and fire boot/timezone
             triggers across reboot and wall-clock changes. Protected system
             broadcasts only, so exported is safe. -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <!-- SPEC 21.1: an app update cancels all alarms and stops the
                     app; re-arm reminders + time triggers on the next update. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
