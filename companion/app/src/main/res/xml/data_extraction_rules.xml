<?xml version="1.0" encoding="utf-8"?>
<!--
  Back up nothing, transfer nothing.

  Everything this app persists lives in filesDir and is one of two things:
  an OUTBOX of events owed to one specific Emacs pairing, or a CACHE of state
  that Emacs re-pushes on the next session. Emacs is the source of truth; the
  Companion is downstream of it. So there is no file here whose restoration
  onto a different device is correct:

    ebp-queue.json      SPEC 15    — events awaiting replay. Restored on a new
                                     device, it re-delivers taps, form submits,
                                     and notification actions that the original
                                     device already delivered. This is the
                                     at-most-once violation W8 was built to
                                     prevent and device-verified.
    ebp-reminders.json  SPEC 18.6  — reminder sets plus FIRED RECEIPTS. Losing
                                     or duplicating a receipt re-fires a
                                     reminder that already fired.
    ebp-triggers.json   SPEC 21.1  — registrations, throttle floors, and
                                     boot/interval baselines. These are
                                     statements about THIS device's history;
                                     they are meaningless on another.
    ebp-surfaces.json   SPEC 13.1  — surface histories, tombstones, drafts.
                                     Carries revision numbers that would make a
                                     fresh session's updates look stale.
    ebp-theme.json      SPEC 18.4  — a pure cache; Emacs re-sends it.

  The exclusions are BLANKET by domain rather than per-filename on purpose: a
  store added later is then covered by default. An opt-in list would silently
  omit it, and the failure mode is duplicate delivery — silent and expensive to
  diagnose.

  minSdk is 34, so this file (API 31+) is the only mechanism that applies;
  the legacy pre-31 `fullBackupContent` attribute is deliberately absent.
-->
<data-extraction-rules>
    <!-- Cloud backup. Belt-and-braces with android:allowBackup="false". -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>

    <!-- Device-to-device transfer. This is the channel allowBackup="false"
         leaves open on Android 12+, and the one that actually matters here:
         D2D is exactly the "same user, new phone" case that would replay a
         restored queue against a live pairing. -->
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
